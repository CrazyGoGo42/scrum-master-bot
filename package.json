{
  "name": "scrum-master-bot",
  "version": "0.1.0",
  "private": false,
  "description": "Discord Scrum Master bot for daily scrums, reminders and weekly reports.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/patch-project-tools.mjs",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.0",
    "luxon": "^3.0.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
